{
  "compilerOptions": {
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": false,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "outDir": ".server",
    "target": "es2019",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["server.ts", "prisma/seed.ts", "src/lib/stocks-data.ts"],
  "exclude": ["node_modules", ".next"]
}
