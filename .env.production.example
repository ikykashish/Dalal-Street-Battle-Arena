# Copy to .env and replace every placeholder before starting the production stack.
POSTGRES_DB=dalal_street_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://postgres:replace-with-a-long-random-password@postgres:5432/dalal_street_db
NEXTAUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
DOMAIN=your-domain.example
NEXTAUTH_URL=https://your-domain.example
SEED_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
